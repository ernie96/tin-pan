<UserControl x:Class="TinPan.Views.SettingsPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:TinPan.Localization">
    <StackPanel Margin="10">
        <TextBlock Text="{l:T 'Settings'}" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <GroupBox Header="{l:T 'Suno account'}" Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <TextBox Text="{Binding SignInText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                         AutomationProperties.Name="{l:T 'Account status'}" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{l:T '_Sign in'}" Padding="10,5" Command="{Binding SignInCommand}"/>
                    <Button Content="{l:T 'Sign _out'}" Padding="10,5" Margin="10,0,0,0" Command="{Binding SignOutCommand}"
                            IsEnabled="{Binding IsSignedIn}"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="{l:T 'Language'}" Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <Label Content="{l:T 'Lan_guage (changes the next time Tin Pan starts)'}" Target="{Binding ElementName=language}" Padding="0,0,0,5"/>
                <ComboBox x:Name="language" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"
                          HorizontalAlignment="Left" MinWidth="300" AutomationProperties.Name="{l:T 'Language'}"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="{l:T 'Speech'}" Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <Label Content="{l:T 'Tin Pan s_peaks'}" Target="{Binding ElementName=speechLevel}" Padding="0,0,0,5"/>
                <ComboBox x:Name="speechLevel" ItemsSource="{Binding SpeechLevels}" SelectedItem="{Binding SpeechLevel}"
                          HorizontalAlignment="Left" MinWidth="300" AutomationProperties.Name="{l:T 'Tin Pan speaks'}"/>
                <Label Content="{l:T '_When a list reaches the playing song'}" Target="{Binding ElementName=playingCue}" Padding="0,10,0,5"/>
                <ComboBox x:Name="playingCue" ItemsSource="{Binding PlayingCues}" SelectedItem="{Binding PlayingCue}"
                          HorizontalAlignment="Left" MinWidth="300" AutomationProperties.Name="{l:T 'When a list reaches the playing song'}"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="{l:T 'Updates'}" Margin="0,0,0,10" Padding="10">
            <CheckBox Content="{l:T 'Check for _new versions when Tin Pan starts'}" IsChecked="{Binding CheckUpdatesAtStartup}"/>
        </GroupBox>

        <GroupBox Header="{l:T 'Downloads'}" Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <Label Content="{l:T '_Download folder (empty means Music\Suno)'}" Target="{Binding ElementName=folder}" Padding="0,0,0,5"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{l:T '_Browse...'}" Padding="10,2" Margin="10,0,0,0" Command="{Binding BrowseCommand}"/>
                    <TextBox x:Name="folder" Text="{Binding DownloadDir}" AutomationProperties.Name="{l:T 'Download folder'}"/>
                </DockPanel>
                <Label Content="{l:T 'Download _format for Ctrl+D (WAV needs Pro or Premier)'}" Target="{Binding ElementName=format}" Padding="0,10,0,5"/>
                <ComboBox x:Name="format" ItemsSource="{Binding OutputFormats}" SelectedItem="{Binding OutputFormat}"
                          Width="150" HorizontalAlignment="Left" AutomationProperties.Name="{l:T 'Download format'}"/>
                <TextBlock Text="{l:T 'Also save next to each download:'}" Margin="0,12,0,4"/>
                <CheckBox Content="{l:T '_Lyrics as text'}" IsChecked="{Binding SaveLyrics}"/>
                <CheckBox Content="{l:T '_Timed lyrics (LRC)'}" IsChecked="{Binding SaveTimedLyrics}" Margin="0,4,0,0"/>
                <CheckBox Content="{l:T 'Song d_etails'}" IsChecked="{Binding SaveDetails}" Margin="0,4,0,0"/>
                <CheckBox Content="{l:T '_Cover art'}" IsChecked="{Binding SaveCover}" Margin="0,4,0,0"/>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>

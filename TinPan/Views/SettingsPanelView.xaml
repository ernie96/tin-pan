<UserControl x:Class="TinPan.Views.SettingsPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="10">
        <TextBlock Text="Settings" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <GroupBox Header="Suno account" Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <TextBox Text="{Binding SignInText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                         AutomationProperties.Name="Account status" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="_Sign in" Padding="10,5" Command="{Binding SignInCommand}"/>
                    <Button Content="Sign _out" Padding="10,5" Margin="10,0,0,0" Command="{Binding SignOutCommand}"
                            IsEnabled="{Binding IsSignedIn}"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Speech" Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <Label Content="Tin Pan s_peaks" Target="{Binding ElementName=speechLevel}" Padding="0,0,0,5"/>
                <ComboBox x:Name="speechLevel" ItemsSource="{Binding SpeechLevels}" SelectedItem="{Binding SpeechLevel}"
                          HorizontalAlignment="Left" MinWidth="300" AutomationProperties.Name="Tin Pan speaks"/>
                <Label Content="_When a list reaches the playing song" Target="{Binding ElementName=playingCue}" Padding="0,10,0,5"/>
                <ComboBox x:Name="playingCue" ItemsSource="{Binding PlayingCues}" SelectedItem="{Binding PlayingCue}"
                          HorizontalAlignment="Left" MinWidth="300" AutomationProperties.Name="When a list reaches the playing song"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Updates" Margin="0,0,0,10" Padding="10">
            <CheckBox Content="Check for _new versions when Tin Pan starts" IsChecked="{Binding CheckUpdatesAtStartup}"/>
        </GroupBox>

        <GroupBox Header="Downloads" Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <Label Content="_Download folder (empty means Music\Suno)" Target="{Binding ElementName=folder}" Padding="0,0,0,5"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="_Browse..." Padding="10,2" Margin="10,0,0,0" Command="{Binding BrowseCommand}"/>
                    <TextBox x:Name="folder" Text="{Binding DownloadDir}" AutomationProperties.Name="Download folder"/>
                </DockPanel>
                <Label Content="Download _format for Ctrl+D (WAV needs Pro or Premier)" Target="{Binding ElementName=format}" Padding="0,10,0,5"/>
                <ComboBox x:Name="format" ItemsSource="{Binding OutputFormats}" SelectedItem="{Binding OutputFormat}"
                          Width="150" HorizontalAlignment="Left" AutomationProperties.Name="Download format"/>
                <TextBlock Text="Also save next to each download:" Margin="0,12,0,4"/>
                <CheckBox Content="_Lyrics as text" IsChecked="{Binding SaveLyrics}"/>
                <CheckBox Content="_Timed lyrics (LRC)" IsChecked="{Binding SaveTimedLyrics}" Margin="0,4,0,0"/>
                <CheckBox Content="Song d_etails" IsChecked="{Binding SaveDetails}" Margin="0,4,0,0"/>
                <CheckBox Content="_Cover art" IsChecked="{Binding SaveCover}" Margin="0,4,0,0"/>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>

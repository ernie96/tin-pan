<UserControl x:Class="TinPan.Views.TrendingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:TinPan.Localization"
             xmlns:local="clr-namespace:TinPan.Views">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="{l:T '_Trending songs'}" Target="{Binding ElementName=trending}" FontSize="18" FontWeight="Bold" Padding="0"/>
            <Button Content="{l:T '_Refresh trending'}" IsTabStop="False" Margin="10,0,0,0" Padding="10,5" Command="{Binding RefreshTrendingCommand}"/>
        </StackPanel>
        <ListBox x:Name="trending" Grid.Row="1" ItemsSource="{Binding Trending}" SelectedItem="{Binding SelectedTrending}"
                 local:PlayingCue.SongsWithCreator="True" AutomationProperties.Name="{l:T 'Trending songs'}" PreviewKeyDown="Trending_PreviewKeyDown"
                 MouseDoubleClick="Trending_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding SpokenWithCreator}" Margin="2"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>

<UserControl x:Class="TinPan.Views.LibraryPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:TinPan.Localization"
             xmlns:local="clr-namespace:TinPan.Views">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="{l:T '_Songs'}" Target="{Binding ElementName=songList}" FontSize="18" FontWeight="Bold" Padding="0" Margin="0,0,10,0"/>
            <Button Content="{l:T '_New song...'}" IsTabStop="False" Padding="10,5" Margin="0,0,8,0"
                    Command="{Binding DataContext.OpenCreateCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="{l:T '_Refresh'}" IsTabStop="False" Padding="10,5" Command="{Binding RefreshCommand}"/>
            <Button Content="{l:T '_Filters...'}" IsTabStop="False" Padding="10,5" Margin="8,0,0,0" Command="{Binding FiltersCommand}"/>
            <Button Content="{l:T 'Download a_ll...'}" IsTabStop="False" Padding="10,5" Margin="8,0,0,0" Command="{Binding DownloadAllCommand}"/>
            <Button Content="{l:T '_Upload...'}" IsTabStop="False" Padding="10,5" Margin="8,0,0,0" Command="{Binding UploadCommand}"/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <Label Content="{l:T 'Searc_h'}" Target="{Binding ElementName=searchBox}" Padding="0,0,8,0" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="{l:T 'Clear search'}" IsTabStop="False" Padding="10,2" Margin="8,0,0,0" Command="{Binding ClearSearchCommand}"/>
            <Button DockPanel.Dock="Right" Content="{l:T 'Search'}" IsTabStop="False" Padding="10,2" Margin="8,0,0,0" Command="{Binding SearchCommand}"/>
            <TextBox x:Name="searchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{l:T 'Search your songs'}" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
        </DockPanel>

        <ListBox x:Name="songList" Grid.Row="2" ItemsSource="{Binding Songs}" SelectedItem="{Binding SelectedClip}"
                 local:PlayingCue.Songs="True" AutomationProperties.Name="{l:T 'Songs'}" PreviewKeyDown="SongList_PreviewKeyDown"
                 MouseDoubleClick="SongList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding SpokenText}" Margin="2"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="{l:T 'Previous'}" IsTabStop="False" Width="80" Margin="5" Padding="5" Command="{Binding PreviousCommand}"/>
            <Button Content="{l:T 'Play or pause'}" IsTabStop="False" Width="100" Margin="5" Padding="5" Command="{Binding PlayPauseCommand}"/>
            <Button Content="{l:T 'Stop'}" IsTabStop="False" Width="80" Margin="5" Padding="5" Command="{Binding StopCommand}"/>
            <Button Content="{l:T 'Next'}" IsTabStop="False" Width="80" Margin="5" Padding="5" Command="{Binding NextCommand}"/>
            <Label Content="{l:T '_Volume'}" Target="{Binding ElementName=volume}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Slider x:Name="volume" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" Width="120"
                    VerticalAlignment="Center" Value="{Binding Volume, Mode=TwoWay}" AutomationProperties.Name="{l:T 'Volume'}"/>
        </StackPanel>
    </Grid>
</UserControl>

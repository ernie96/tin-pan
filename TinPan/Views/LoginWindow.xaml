<Window x:Class="TinPan.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:TinPan.Localization"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{l:T 'Sign in to Suno'}" Height="750" Width="500" WindowStartupLocation="CenterOwner">
    <Grid>
        <wv2:WebView2 x:Name="webView" AutomationProperties.Name="{l:T 'Suno sign-in page'}"/>
    </Grid>
</Window>

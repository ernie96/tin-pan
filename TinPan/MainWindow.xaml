<Window x:Class="TinPan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:TinPan.Localization"
        xmlns:localViews="clr-namespace:TinPan.Views"
        Title="{Binding Title}" Height="750" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding ContextHelpCommand}" />
        <KeyBinding Key="F1" Modifiers="Ctrl" Command="{Binding FullHelpCommand}" />
        <KeyBinding Key="F2" Command="{Binding ReadCreditsCommand}" />
        <KeyBinding Key="F2" Modifiers="Shift" Command="{Binding ReadSubscriptionCommand}" />
        <KeyBinding Key="F7" Modifiers="Shift" Command="{Binding LibraryVM.SeekCommand}" CommandParameter="-10" />
        <KeyBinding Key="F9" Modifiers="Shift" Command="{Binding LibraryVM.SeekCommand}" CommandParameter="10" />
        <KeyBinding Key="F3" Command="{Binding NowPlayingCommand}" />
        <KeyBinding Key="F3" Modifiers="Shift" Command="{Binding ToggleLiveLyricsCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding ShowTabCommand}" CommandParameter="0" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding ShowTabCommand}" CommandParameter="1" />
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding ShowTabCommand}" CommandParameter="2" />
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding ShowTabCommand}" CommandParameter="3" />
        <KeyBinding Key="D5" Modifiers="Ctrl" Command="{Binding ShowTabCommand}" CommandParameter="4" />
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding OpenCreateCommand}" />
        <KeyBinding Key="F6" Command="{Binding NextWindowCommand}" />
        <KeyBinding Key="F6" Modifiers="Shift" Command="{Binding NextWindowCommand}" CommandParameter="back" />
        <KeyBinding Key="F7" Command="{Binding PreviousCommand}" />
        <KeyBinding Key="F8" Command="{Binding PlayPauseCommand}" />
        <KeyBinding Key="F8" Modifiers="Shift" Command="{Binding LibraryVM.StopCommand}" />
        <KeyBinding Key="F9" Command="{Binding NextCommand}" />
        <KeyBinding Key="F11" Command="{Binding LibraryVM.VolumeDownCommand}" />
        <KeyBinding Key="F12" Command="{Binding LibraryVM.VolumeUpCommand}" />
        <KeyBinding Key="F12" Modifiers="Ctrl+Shift" Command="{Binding ToggleOutputCommand}" />
        <KeyBinding Key="MediaPlayPause" Command="{Binding PlayPauseCommand}" />
        <KeyBinding Key="MediaStop" Command="{Binding LibraryVM.StopCommand}" />
        <KeyBinding Key="MediaPreviousTrack" Command="{Binding PreviousCommand}" />
        <KeyBinding Key="MediaNextTrack" Command="{Binding NextCommand}" />
        <KeyBinding Key="F7" Modifiers="Ctrl" Command="{Binding SeekPercentCommand}" CommandParameter="-10" />
        <KeyBinding Key="F9" Modifiers="Ctrl" Command="{Binding SeekPercentCommand}" CommandParameter="10" />
        <KeyBinding Key="F8" Modifiers="Ctrl" Command="{Binding RestartCommand}" />
        <KeyBinding Key="F8" Modifiers="Ctrl+Shift" Command="{Binding ResumeCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding RepeatCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl+Shift" Command="{Binding HistoryCommand}" />
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding SearchCommand}" />
        <KeyBinding Key="B" Modifiers="Ctrl+Shift" Command="{Binding ReportProblemCommand}" />
        <KeyBinding Key="F" Modifiers="Ctrl+Shift" Command="{Binding SuggestFeatureCommand}" />
    </Window.InputBindings>

    <DockPanel>
    <!-- Built from MainViewModel.Commands in code, so it always matches the Ctrl+F1 list.
         Hidden until Alt or F10, like a classic Windows menu, so Tab and the screen reader don't meet it. -->
    <Menu x:Name="mainMenu" DockPanel.Dock="Top" Visibility="Collapsed" AutomationProperties.Name="{l:T 'Menu bar'}"/>
    <TabControl x:Name="mainTabs" Margin="10" SelectedIndex="{Binding SelectedTab}" SelectionChanged="MainTabs_SelectionChanged">
        <!-- Order matches Ctrl+1 to Ctrl+5 and the tab numbers in MainViewModel. Create is a window of its own (Ctrl+N). -->
        <TabItem Header="{l:T 'Library'}">
            <localViews:LibraryPanelView x:Name="libraryView" DataContext="{Binding LibraryVM}" />
        </TabItem>
        <TabItem Header="{l:T 'Playlists'}">
            <localViews:PlaylistsView x:Name="playlistsView" DataContext="{Binding PlaylistsVM}" />
        </TabItem>
        <TabItem Header="{l:T 'Trending'}">
            <localViews:TrendingView x:Name="trendingView" DataContext="{Binding SunoVM}" />
        </TabItem>
        <TabItem Header="{l:T 'Account'}">
            <localViews:AccountView x:Name="accountView" DataContext="{Binding SunoVM}" />
        </TabItem>
        <TabItem Header="{l:T 'Settings'}">
            <localViews:SettingsPanelView x:Name="settingsView" DataContext="{Binding SettingsVM}" />
        </TabItem>
    </TabControl>
    </DockPanel>
</Window>

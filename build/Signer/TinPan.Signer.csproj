<Project Sdk="Microsoft.NET.Sdk">
  <!-- Signs release downloads for the in-app updater. Not shipped to users. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- The app's own signature code, so signing and checking can't drift apart. -->
    <Compile Include="..\..\TinPan\Services\UpdateSignature.cs" Link="UpdateSignature.cs" />
  </ItemGroup>
</Project>
